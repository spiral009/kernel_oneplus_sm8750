# === Container / Docker / LXC Requirements ===
CONFIG_USER_NS=y
CONFIG_CGROUP_MISC=y
CONFIG_CGROUP_RDMA=y
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_WRR=y
CONFIG_IP_VS_SH=y
CONFIG_IP_VS_DH=y

# Networking for containers
CONFIG_VETH=y
CONFIG_MACVLAN=y
CONFIG_MACVTAP=y
CONFIG_NET_NS=y
CONFIG_BRIDGE_NETFILTER=y

# Filesystem for Docker
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y

# Virtio for best performance
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_CONSOLE=y

# KVM
CONFIG_KVM=y
CONFIG_KVM_ARM_HOST=y
CONFIG_KVM_ARM_HYPERVISOR=y
CONFIG_KVM_ARM_VHE=y
CONFIG_KVM_ARM_MODE=nvhe   # already in your cmdline

# Extra for nested virt / good performance
CONFIG_VIRTIO=y
CONFIG_VHOST=y
CONFIG_VHOST_NET=y
CONFIG_VHOST_VSOCK=y

# General container tools
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y

# Security / AppArmor / SELinux (Docker-friendly)
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_SELINUX=y

# For Docker build / large images
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_THIN_PROVISIONING=y

