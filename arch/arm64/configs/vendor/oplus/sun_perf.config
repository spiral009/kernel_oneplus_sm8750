# OPLUS camera
CONFIG_OPLUS_CAMERA_AW37004=m

# OPLUS charger
CONFIG_OPLUS_ADSP_CHARGER=y
CONFIG_OPLUS_AUDIO_SWITCH_GLINK=y
CONFIG_OPLUS_CALL_MODE_SUPPORT=y
CONFIG_OPLUS_CHARGER=y
CONFIG_OPLUS_CHARGER_MAXIM=y
CONFIG_OPLUS_CHECK_CHARGERID_VOLT=y
CONFIG_OPLUS_CHG_ADSP_VOOCPHY=y
CONFIG_OPLUS_CHG_AP_VOOCPHY=y
CONFIG_OPLUS_CHG_DRM_PANEL_NOTIFY=y
CONFIG_OPLUS_CHG_IC_DEBUG=y
CONFIG_OPLUS_CHG_MMS_DEBUG=y
CONFIG_OPLUS_CHG_TEST_KIT=m
CONFIG_OPLUS_CHG_V2=m
CONFIG_OPLUS_CHG_VOOCPHY=y
CONFIG_OPLUS_CHG_VOOCPHY_CHGLIB=y
CONFIG_OPLUS_CHIP_SOC_NODE=y
CONFIG_OPLUS_GAUGE_BQ27Z561=y
CONFIG_OPLUS_GAUGE_NFG8011B=y
CONFIG_OPLUS_I2C_RST_NOTIFY=m
CONFIG_OPLUS_PHY_SC8547D=y
CONFIG_OPLUS_RTC_DET_SUPPORT=y
CONFIG_OPLUS_SC7637_LEVEL_SHIFT=y
CONFIG_OPLUS_SHIP_MODE_SUPPORT=y
CONFIG_OPLUS_SMART_CHARGER_SUPPORT=y
CONFIG_OPLUS_STATE_RETENTION=y
CONFIG_OPLUS_SY6603_BATT_BAL=y
CONFIG_OPLUS_TPS6128XD_CHARGER=y
CONFIG_OPLUS_UFCS_CLASS=m
CONFIG_OPLUS_UFCS_SC8547A=y
CONFIG_OPLUS_VOOCPHY_SC8517=y
CONFIG_OPLUS_VOOCPHY_SLAVE_SC8547=y
CONFIG_OPLUS_WIRELESS_NU1669=y
CONFIG_OPLUS_WIRELESS_PEN=m
CONFIG_OPLUS_WIRELESS_PEN_CPS8601=y
CONFIG_OPLUS_WIRELESS_SC96257=y

# OPLUS device info
CONFIG_OPLUS_DEVICE_IFNO=m

# OPLUS fan
CONFIG_OPLUS_FAN=m

# OPLUS feature
CONFIG_OPLUS_FEATURE_BOOTLOADER_LOG=m
CONFIG_OPLUS_FEATURE_BOOTMODE=m
CONFIG_OPLUS_FEATURE_BUILDVARIANT=m
CONFIG_OPLUS_FEATURE_CDT=m
CONFIG_OPLUS_FEATURE_CHARGERPRESENT=m
CONFIG_OPLUS_FEATURE_FEEDBACK=m
CONFIG_OPLUS_FEATURE_FTMMODE=m
CONFIG_OPLUS_FEATURE_MM_FEEDBACK=m
CONFIG_OPLUS_FEATURE_OLC=m
CONFIG_OPLUS_FEATURE_OPLUSBOOT=m
CONFIG_OPLUS_FEATURE_OPROJECT=m
CONFIG_OPLUS_FEATURE_PMIC_MONITOR=m
CONFIG_OPLUS_FEATURE_QCOM_PMICWD=m
CONFIG_OPLUS_FEATURE_RECORD_MDMRST=m

# OPLUS fpga
CONFIG_OPLUS_FPGA_NOTIFY=m

# OPLUS FW update
CONFIG_OPLUS_FW_UPDATE=m

# OPLUS haptic
CONFIG_AW_HAPTIC=y
CONFIG_HAPTIC_FEEDBACK=m
CONFIG_OPLUS_HAPTIC_COMMON=m
CONFIG_SIH_HAPTIC=y

# OPLUS keyboard
CONFIG_OPLUS_POGOPIN_FUNCTION=y

# OPLUS LED driver
CONFIG_LEDS_AW210XX=m

# OPLUS magcover
CONFIG_OPLUS_MAGCVR_NOTIFY=m

# OPLUS platform
CONFIG_OPLUS_SYSTEM_KERNEL_QCOM=y

# OPLUS touchpanel
CONFIG_TOUCHPANEL_NOTIFY=m

# OPLUS trackpoint
CONFIG_OPLUS_TRACKPOINT_REPORT=m

# OPLUS UFS
CONFIG_OPLUS_QCOM_UFS_DRIVER=y
CONFIG_OPLUS_UFS_DRIVER=m

# QCOM power
CONFIG_INPUT_QPNP_POWER_ON=m

# QCOM PWM LPG
CONFIG_PWM_QTI_LPG=m

# QCOM USB
CONFIG_USB_CONFIGFS_RNDIS=m

# SAMSUNG V7 UFS TW/HID
CONFIG_UFSFEATURE=y
CONFIG_UFSHID=y
CONFIG_UFSHID_POC=y
CONFIG_TANGO32=m
CONFIG_NTSYNC=m

# Kernel configurations for full DroidSpaces support
# Copyright (C) 2026 ravindu644 <droidcasts@protonmail.com>

# IPC mechanisms (required for tools that rely on shared memory and IPC namespaces)
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Core namespace support (essential for isolation and running init systems)
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y

# Seccomp support (enables syscall filtering and security hardening)
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Control groups support (required for systemd and resource accounting)
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y

# Device filesystem support (enables hardware access when --hw-access is enabled)
CONFIG_DEVTMPFS=y

# Overlay filesystem support (required for volatile mode)
CONFIG_OVERLAY_FS=y

# Firmware loading support (optional, used when --hw-access is enabled)
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_COMPRESS=y

# Droidspaces Network Isolation Support - NAT/none modes
# Network namespace isolation
CONFIG_NET_NS=y

# Virtual ethernet pairs
CONFIG_VETH=y

# Bridge device
CONFIG_BRIDGE=y

# Netfilter core
CONFIG_NETFILTER=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y

# Connection tracking
CONFIG_NF_CONNTRACK=y
# kernels ≤ 4.18 (Android 4.4 / 4.9)
CONFIG_NF_CONNTRACK_IPV4=y

# iptables infrastructure
CONFIG_IP_NF_IPTABLES=y

# filter table
CONFIG_IP_NF_FILTER=y

# NAT table
CONFIG_NF_NAT=y

# NF Tables
CONFIG_NF_TABLES=y

# kernels ≤ 5.0 (Kernel 4.4 / 4.9)
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_NAT=y

# MASQUERADE target (renamed in 5.2)
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y

# MSS clamping
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y

# addrtype match (required for --dst-type LOCAL DNAT port forwarding)
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# Conntrack netlink + NAT redirect (required for stateful NAT)
CONFIG_NF_CONNTRACK_NETLINK=y
CONFIG_NF_NAT_REDIRECT=y

# Policy routing
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# Disable this on older kernels to make internet work
CONFIG_ANDROID_PARANOID_NETWORK=n
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_IP_NF_TARGET_ULOG=y

# FAIL2BAN CORE
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y

# IPSET (efficient fail2ban banlists)
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# NFNETLINK / logging
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y

# Additional kernel hardening/performance configs
CONFIG_ARM64_VA_BITS_48=y
CONFIG_RANDOMIZE_BASE=n
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODULE_FORCE_LOAD=y
#CONFIG_STRICT_MODULE_RWX=n
CONFIG_MODULE_SIG_PROTECT=n
#CONFIG_ARCH_HAS_STRICT_KERNEL_RWX=n
#CONFIG_STRICT_KERNEL_RWX=n
#CONFIG_ARCH_HAS_STRICT_MODULE_RWX=n
#CONFIG_STRICT_MODULE_RWX=n
#CONFIG_ARM64_MTE=n
#CONFIG_ARM64_AS_HAS_MTE=n

# MT7601U wireless support
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MAC80211=m
CONFIG_MT7601U=m
CONFIG_TLS_STATS=y
CONFIG_PSTORE_COMPRESS=n
CONFIG_DMA_BUF_EXPORT=y
CONFIG_DMABUF_HEAPS=y
CONFIG_CFS_BANDWIDTH=y

